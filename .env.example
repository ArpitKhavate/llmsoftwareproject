# Copy to .env and fill in. NEVER commit .env (judges deduct points for keys in code).
CAMERA=0                 # webcam index (0 = built-in, 1 = Logitech usually) or nest_backup.mp4
DOOR_Y_FRAC=0.5          # door line height as a fraction of the frame
INSIDE_IS_BELOW=1        # 1 if "inside the store" is below the line in the image
COUNTER_ZONE=            # optional x1,y1,x2,y2 fractions, e.g. 0.6,0.0,1.0,0.4

ANTHROPIC_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_TO=
